# Copy to .env.local for development. In production set real values in Hostinger's
# panel (Node.js app → Environment variables). Never commit real values.

# --- Site (public) ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Brixora
NEXT_PUBLIC_DEFAULT_CITY=Mangalore
NEXT_PUBLIC_BROKERAGE_PHONE=919800000000
NEXT_PUBLIC_BROKERAGE_WHATSAPP=919800000000
NEXT_PUBLIC_BROKERAGE_EMAIL=
NEXT_PUBLIC_BROKERAGE_ADDRESS=
NEXT_PUBLIC_BROKERAGE_RERA=

# --- Database (Hostinger MySQL) ---------------------------------------------
# hPanel → Databases → MySQL Databases. Use the password as-is (no encoding needed).
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_brixora
DB_PASS=
DB_NAME=u123456789_brixora
# DB_POOL_SIZE=5
# Set to true when the database is on another host and requires TLS.
# DB_SSL=false

# --- Auth -------------------------------------------------------------------
# Keys session-code hashing and the encryption of the admin's 2FA secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates pending login codes and the admin's authenticator setup.
AUTH_SECRET=

# Staff two-factor (authenticator app) for admins and agents. On by default.
# Set to "off" for password-only staff sign-in.
# ADMIN_2FA=on

# --- Email (SMTP) -------------------------------------------------------------
# Staff password-reset codes, "password changed" notices, agent welcome emails.
# Hostinger: hPanel → Emails → create a mailbox, then smtp.hostinger.com / 465 / ssl.
# Empty SMTP_HOST in development = emails are printed to the server console.
# Production refuses to send without it. Hostinger value: smtp.hostinger.com
SMTP_HOST=
SMTP_PORT=465
# ssl = TLS from the start (465) · tls = STARTTLS (587) · none = plain, localhost relay only
SMTP_SECURE=ssl
SMTP_USER=no-reply@yourdomain.in
SMTP_PASS=
# Sender address (defaults to SMTP_USER) and display name (defaults to the brand name).
MAIL_FROM=no-reply@yourdomain.in
MAIL_FROM_NAME=Brixora

# --- Uploads ----------------------------------------------------------------
# Absolute path OUTSIDE the deployed app folder, so redeploys don't delete photos,
# e.g. /home/u123456789/brixora-uploads. Defaults to ./.uploads in development.
UPLOAD_DIR=

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token for GET /api/cron/expire-listings (daily cron job).
CRON_SECRET=

# --- WhatsApp Cloud API -----------------------------------------------------
# Empty token in development = dev mode: messages are logged to the console, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret (verifies webhook signatures) and any random verify token you also
# paste into the Meta webhook config.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# Connect the existing WhatsApp Business app number from Admin → Settings → WhatsApp
# (Embedded Signup, coexistence). The connected number overrides WHATSAPP_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID above. META_APP_ID is the Meta app ID; WHATSAPP_ES_CONFIG_ID
# is the Facebook Login for Business configuration ID for WhatsApp Embedded Signup.
META_APP_ID=
WHATSAPP_ES_CONFIG_ID=
WHATSAPP_TEMPLATE_LANG=en
# Number that receives enquiry forwards (defaults to NEXT_PUBLIC_BROKERAGE_WHATSAPP).
# Must not be the WhatsApp Business API number itself: with coexistence the brokerage's
# own WhatsApp is the API number, so set this to another number (e.g. the manager's).
BROKERAGE_ENQUIRY_WHATSAPP=

# --- Cloudflare Turnstile ---------------------------------------------------
# Left empty in development, Cloudflare's always-pass test keys are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
